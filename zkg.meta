[package]
script_dir = scripts
test_command = cd testing && btest -c btest.cfg
summary = Add Subject Public Key Info (SPKI) hash to x509.log
description = This package adds the Subject Public Key Info (SPKI) or each x509 certificate to x509.log.
	It can span multiple lines, with this indentation.
depends = 
	zeek >=4.0.0

[template]
source = https://github.com/zeek/package-template
version = v3.1.8
zkg_version = 3.2.0
features = license

[template_vars]
name = X509SPKI
author = Johanna Amann
license = bsd-2

